PORT=8080
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/shipnow_peru

# opcional: fuerza el nivel minimo del logger (fatal, error, warning, info, http, debug).
# si no se define, se decide solo segun NODE_ENV (debug en development, info en production).
LOG_LEVEL=

# ShipNow todavia no tiene login/autenticacion, asi que no hay JWT_SECRET
# todavia. El dia que se agregue login, va a vivir aca -- nunca hardcodeado.
# JWT_SECRET=

# ShipNow todavia no consume ningun servicio externo (pasarela de pago,
# email, etc). El dia que se sume uno, su URL/credenciales van aca.
